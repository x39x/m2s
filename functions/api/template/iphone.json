{
    "log": {
        "level": "info",
        "timestamp": true
    },
    "experimental": {
        "cache_file": {
            "enabled": true,
            "store_fakeip": true,
            "store_dns": true
        }
    },
    "dns": {
        "servers": [
            {
                "type": "https",
                "tag": "dialing",
                "server": "223.5.5.5"
            },
            {
                "type": "https",
                "tag": "cn_dns",
                "server": "dns.alidns.com",
                "domain_resolver": {
                    "server": "dialing"
                }
            },
            {
                "type": "https",
                "tag": "proxy_dns",
                "server": "cloudflare-dns.com",
                "detour": "albatross"
            },
            {
                "type": "fakeip",
                "tag": "fake_dns",
                "inet4_range": "198.18.0.0/15",
                "inet6_range": "fc00::/18"
            }
        ],
        "rules": [
            {
                "rule_set": "geosite-category-ads-all",
                "action": "predefined",
                "rcode": "NOERROR"
            },
            {
                "clash_mode": "direct",
                "server": "cn_dns"
            },
            {
                "clash_mode": "global",
                "server": "fake_dns"
            },
            {
                "query_type": ["A", "AAAA"],
                "server": "fake_dns"
            }
        ],
        "final": "proxy_dns"
    },
    "inbounds": [
        {
            "type": "tun",
            "tag": "SBTUN",
            "mtu": 9000,
            "address": ["172.18.0.1/30", "fdfe:dcba:9876::1/126"],
            "dns_mode": "hijack",
            "auto_route": true,
            "strict_route": true,
            "stack": "mixed"
        }
    ],
    "outbounds": [
        {
            "type": "direct",
            "tag": "swift",
            "domain_resolver": "cn_dns"
        },
        {
            "type": "selector",
            "tag": "cuckoo",
            "interrupt_exist_connections": true,
            "outbounds": ["urltest"],
            "default": "urltest"
        },
        {
            "type": "selector",
            "tag": "godwit",
            "interrupt_exist_connections": true,
            "outbounds": ["urltest"],
            "default": "urltest"
        },
        {
            "type": "selector",
            "tag": "seagull",
            "interrupt_exist_connections": true,
            "outbounds": ["urltest"],
            "default": "urltest"
        },
        {
            "type": "selector",
            "tag": "albatross",
            "interrupt_exist_connections": true,
            "outbounds": ["cuckoo", "godwit", "seagull"],
            "default": "cuckoo"
        },
        {
            "type": "selector",
            "tag": "ai",
            "interrupt_exist_connections": true,
            "outbounds": ["albatross", "cuckoo", "godwit", "seagull"],
            "default": "albatross"
        },
        {
            "type": "selector",
            "tag": "stream",
            "interrupt_exist_connections": true,
            "outbounds": ["albatross", "cuckoo", "godwit", "seagull"],
            "default": "albatross"
        },
        {
            "type": "selector",
            "tag": "stream-cn",
            "interrupt_exist_connections": true,
            "outbounds": ["albatross", "cuckoo", "godwit", "seagull", "swift"],
            "default": "swift"
        },
        {
            "type": "selector",
            "tag": "apple",
            "interrupt_exist_connections": true,
            "outbounds": ["albatross", "cuckoo", "godwit", "seagull", "swift"],
            "default": "albatross"
        },
        {
            "type": "selector",
            "tag": "apple-cn",
            "interrupt_exist_connections": true,
            "outbounds": ["albatross", "cuckoo", "godwit", "seagull", "swift"],
            "default": "swift"
        },
        {
            "type": "urltest",
            "tag": "urltest",
            "interrupt_exist_connections": true,
            "outbounds": []
        }
    ],
    "http_clients": [
        {
            "tag": "proxy_http_client",
            "disable_version_fallback": true,
            "detour": "albatross"
        },
        {
            "tag": "direct_http_client",
            "disable_version_fallback": true,
            "detour": "swift"
        }
    ],
    "route": {
        "rules": [
            {
                "action": "sniff"
            },
            {
                "protocol": "quic",
                "action": "reject",
                "no_drop": true
            },
            {
                "clash_mode": "global",
                "outbound": "albatross"
            },
            {
                "clash_mode": "direct",
                "outbound": "swift"
            },
            {
                "protocol": ["bittorrent", "ntp"],
                "outbound": "swift"
            },
            {
                "rule_set": ["lan", "geosite-private", "direct"],
                "outbound": "swift"
            },
            {
                "rule_set": ["ai", "geosite-category-ai-!cn"],
                "outbound": "ai"
            },
            {
                "rule_set": "stream",
                "outbound": "stream"
            },
            {
                "rule_set": ["stream_cn", "geosite-bilibili"],
                "outbound": "stream-cn"
            },
            {
                "rule_set": ["apple_cdn", "apple_cn", "microsoft_cdn"],
                "outbound": "apple-cn"
            },
            {
                "rule_set": ["apple_services", "apple_intelligence", "microsoft"],
                "outbound": "apple"
            },
            {
                "rule_set": "domestic",
                "outbound": "swift"
            },
            {
                "rule_set": "global",
                "outbound": "albatross"
            },
            {
                "rule_set": "gfw",
                "outbound": "albatross"
            },
            {
                "rule_set": "geosite-geolocation-cn",
                "outbound": "swift"
            },
            {
                "rule_set": "geosite-geolocation-!cn",
                "outbound": "albatross"
            },
            {
                "rule_set": "geosite-category-ads-all",
                "action": "reject"
            },
            {
                "action": "resolve",
                "server": "proxy_dns"
            },
            {
                "ip_is_private": true,
                "outbound": "swift"
            },
            {
                "rule_set": "apple_services_ip",
                "outbound": "apple"
            },
            {
                "rule_set": "stream_ip",
                "outbound": "stream"
            },
            {
                "rule_set": ["china_ip", "geoip-cn"],
                "outbound": "swift"
            },
            {
                "rule_set": "china_ip_ipv6",
                "outbound": "swift"
            }
        ],
        "rule_set": [
            {
                "type": "remote",
                "tag": [
                    "geosite-private",
                    "geosite-bilibili",
                    "geosite-category-ai-!cn",
                    "geosite-geolocation-cn",
                    "geosite-geolocation-!cn",
                    "geosite-category-ads-all"
                ],
                "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/{tag}.srs",
                "update_interval": "24h0m0s"
            },
            {
                "type": "remote",
                "tag": ["geoip-cn"],
                "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geoip@rule-set/{tag}.srs",
                "update_interval": "24h0m0s"
            },
            {
                "type": "remote",
                "tag": ["gfw"],
                "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/{tag}.srs",
                "update_interval": "24h0m0s"
            },
            {
                "type": "remote",
                "tag": [
                    "lan",
                    "direct",
                    "ai",
                    "stream",
                    "apple_cn",
                    "apple_cdn",
                    "apple_services",
                    "apple_intelligence",
                    "microsoft",
                    "microsoft_cdn",
                    "global",
                    "domestic"
                ],
                "url": "https://ruleset.skk.moe/sing-box/non_ip/{tag}.json",
                "update_interval": "24h0m0s"
            },
            {
                "type": "remote",
                "tag": "apple_services_ip",
                "url": "https://ruleset.skk.moe/sing-box/ip/apple_services.json",
                "update_interval": "24h0m0s"
            },
            {
                "type": "remote",
                "tag": "stream_ip",
                "url": "https://ruleset.skk.moe/sing-box/ip/stream.json",
                "update_interval": "24h0m0s"
            },
            {
                "type": "remote",
                "tag": ["china_ip", "china_ip_ipv6"],
                "url": "https://ruleset.skk.moe/sing-box/ip/{tag}.json",
                "update_interval": "24h0m0s"
            },
            {
                "tag": "stream_cn",
                "rules": [
                    {
                        "domain_suffix": ["iqiyi.com"]
                    }
                ]
            }
        ],
        "final": "albatross",
        "auto_detect_interface": true,
        "default_domain_resolver": "cn_dns",
        "default_http_client": "proxy_http_client"
    }
}
